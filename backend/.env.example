# Backend configuration.
#
# Copy this to backend/.env and fill in the AI Hub credentials. That is the
# only environment file: the local server, the test suite, docker compose and
# the evaluation harness all read it, so there is nothing to keep in sync.
#
# Several readers, one file. Each ignores the keys it does not own, which is
# why the harness's JUDGE_* values can live here without SENTRA objecting.
#
# The values here are the ones that work when you run the backend on your own
# machine. docker compose overrides the three that differ inside a container
# (QDRANT_URL, DOCUMENTS_DIR, FEEDBACK_FILE) in docker-compose.yml, the same way
# the Kubernetes configmap does.

# AI Model Hub. No defaults, the application will not start without these.
AI_HUB_BASE_URL=https://your-hub-url.example.com/v1
AI_HUB_API_KEY=your-virtual-key-here

# Model names, as shown in the AI Hub
EMBEDDING_MODEL=octen-embedding-8b
CHAT_MODEL=llama-3-3-70b

# Vector width EMBEDDING_MODEL produces. Changing the model almost certainly
# means changing this, and startup refuses if an existing collection was built
# at a different width.
EMBEDDING_DIM=4096

# How long to wait on the AI Hub. Measured against ours: embedding one query
# takes about 0.2s, and an answer or an overview 20 to 29s. These leave about
# four times the slowest. Exceeding one comes back to the caller as a 503.
EMBEDDING_TIMEOUT_SECONDS=60
GENERATION_TIMEOUT_SECONDS=120

# Qdrant. Compose overrides this with http://qdrant:6333
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=bundestag_documents
DOC_COLLECTION_NAME=bundestag_doc_summaries

# Ingestion. Relative to backend, which is where you run the server from.
# Compose overrides this with /data/Ausarbeitungen, the bind mount of data/.
DOCUMENTS_DIR=../data/Ausarbeitungen
CHUNK_MAX_TOKENS=2048
EMBEDDING_BATCH_SIZE=32

# Chunks retrieved for a generated answer when the request does not say.
# Document search and similar-document lookups have their own defaults.
RETRIEVAL_TOP_K=10

# Browser origins allowed to call the API, comma-separated or a JSON array.
# Only needed for the vite dev server; under compose nginx proxies /api.
CORS_ORIGINS=http://localhost:5173

# Feedback log. Compose overrides this with /data/feedback.jsonl, which is the
# same file through the bind mount.
FEEDBACK_FILE=../data/feedback.jsonl

# ── Evaluation harness (optional) ───────────────────────────────────
#
# Off unless EVAL_ENABLED is true. main imports sentra.evaluation only when it
# is, so an image built without the `eval` extra boots normally with this unset.
EVAL_ENABLED=false

# Read only when the harness is on, and then required. The judge must not be
# CHAT_MODEL: startup refuses rather than let a round produce 180 verdicts of
# SENTRA agreeing with itself. Normally a different hub as well.
# JUDGE_BASE_URL=https://your-judge-hub.example.com/v1
# JUDGE_API_KEY=your-judge-key-here
# JUDGE_MODEL=qwen3-8-27b
#
# qwen3-8-27b was chosen by measuring, not by size. Five comparison cases were
# put to the four plausible models on the hub; it was the only one that caught
# both a changed Aktenzeichen and a dropped "grundsätzlich", while still passing
# two paraphrase controls. gpt-oss-120b and gemma-4-31b scored 4/5,
# ministral-3-14b 3/5 and missed the changed source, which is exactly what the
# two reference fields exist to catch. See #112.

# Where the runner finds SENTRA. Over HTTP on purpose: the API layer is part of
# what is being tested. Defaults to talking to ourselves.
# SENTRA_BASE_URL=http://localhost:8000

# The eval database. The default matches the compose service on the host port,
# so a developer turning the harness on locally needs to set nothing. Compose
# overrides it for the container, where the service is reachable as eval-db:5432.
# Apply the schema once with:  uv run alembic upgrade head
# EVAL_DATABASE_URL=postgresql+psycopg://sentra:sentra@localhost:5433/sentra_eval

# ── The guard on writing and on personal data ────────────────────────
# One token, checked on POST /api/ingest and GET /api/feedback (#162). Those
# two had nothing in front of them: a re-index writes to the corpus WD reads as
# authoritative, and the feedback file is user-typed questions — personal data
# under DSGVO.
#
# This is not a login. It says a caller was given the secret, nothing about who
# they are. references/SECURITY_NOTES.md has the full picture, including what
# it deliberately does not cover.
#
# Leave it empty and those endpoints stay open — which GET /api/health reports
# as auth="offen", so the state is visible rather than assumed. Set it and
# every caller needs it, including the evaluation harness and the frontend:
#
#   ADMIN_TOKEN=...                 SENTRA checks it
#   SENTRA_ADMIN_TOKEN=...          the harness sends it (same value)
#   VITE_ADMIN_TOKEN=...            the frontend sends it, at build time
#
# The frontend one is build-time and therefore readable by anyone who opens the
# network tab. It keeps the open internet out; it does not keep a user out.
#
# ADMIN_TOKEN=
# SENTRA_ADMIN_TOKEN=
